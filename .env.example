# ============================================================
# Environment Configuration — copy to .env and fill in values
# ============================================================

# MongoDB connection string (local default shown)
# For production, use your MongoDB Atlas URI
MONGO_URI=mongodb://localhost:27017/api_builder

# Flask secret key (change in production!)
FLASK_SECRET_KEY=change-me-to-a-random-string

# Flask server port
FLASK_PORT=5000

# Debug mode (set to False in production)
FLASK_DEBUG=True

# Frontend URL for CORS (set to your Vercel URL in production)
# Example: https://your-app.vercel.app
FRONTEND_URL=
